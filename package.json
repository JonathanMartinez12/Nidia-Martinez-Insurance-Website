{
  "name": "plus65-medicare-advisors",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (EN/ES) local-SEO website for Plus 65 Medicare Advisors — Greater New Orleans, Louisiana.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "tsx scripts/lhci-urls.ts && lhci autorun",
    "check:launch": "tsx scripts/check-launch-blockers.ts",
    "icons": "tsx scripts/generate-icons.tsx",
    "screenshots": "tsx scripts/screenshots.ts",
    "verify": "tsx scripts/verify.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.5",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
