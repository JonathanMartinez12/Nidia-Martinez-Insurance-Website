# ─────────────────────────────────────────────────────────────────────────────
# Martinez Insurance Solutions — environment variables
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, no trailing slash. Used for canonical URLs, hreflang, sitemap,
# Open Graph and JSON-LD. On Vercel, falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Contact form email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Every lead goes to all of these (comma-separated).
CONTACT_TO_EMAILS=nidiamartinez576@outlook.com,martj5493@gmail.com
# Must be an address on a domain verified in Resend (SPF + DKIM), e.g.:
CONTACT_FROM_EMAIL="Martinez Insurance Solutions <leads@your-domain.com>"

# ── Analytics (optional) ─────────────────────────────────────────────────────
# GA4 Measurement ID. When empty, no analytics script is loaded at all.
NEXT_PUBLIC_GA_ID=

# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# Enabled only when BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Spam protection tuning (optional) ────────────────────────────────────────
# Minimum ms between page load and submit (default 3000).
# FORM_MIN_SUBMIT_MS=3000
# Max submissions per IP per 10 minutes (default 5).
# FORM_RATE_LIMIT=5

# ── Testing only ─────────────────────────────────────────────────────────────
# "mock" writes emails to EMAIL_OUTBOX_DIR instead of sending (used by e2e tests).
# EMAIL_TRANSPORT=mock
# EMAIL_OUTBOX_DIR=.e2e-outbox
